# SEOforge Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/seoforge_production

# Redis
REDIS_URL=redis://localhost:6379/0

# Rails
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_MASTER_KEY=your_master_key_here
RAILS_ENV=production
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Domain & Protocol
DOMAIN=seoforge.contentforce.ru
PROTOCOL=https

# AI/LLM Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Payment
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google OAuth (for Analytics & Search Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Sidekiq
SIDEKIQ_CONCURRENCY=10

# SMTP (optional - for email notifications)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=seoforge.contentforce.ru
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Sentry (optional - for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# Asset Host (optional - for CDN)
ASSET_HOST=https://cdn.seoforge.contentforce.ru
